import "./models/media.zmodel"
import "./models/customer.zmodel"
import "./models/user.zmodel"
import "./models/address.zmodel"
import "./models/cart.zmodel"
import "./models/order.zmodel"
import "./models/payment.zmodel"
import "./models/product.zmodel"
import "./models/system.zmodel"
import "./models/rating.zmodel"

generator client {
  provider               = "prisma-client"
  binaryTargets          = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
  output                 = "../../../../../../libs/shared/src/prisma/generated"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}