datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider               = "prisma-client"
  binaryTargets          = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
  output                 = "../../../../../../libs/shared/src/prisma/generated"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

enum MediaType {
  Image
  Video
  Audio
  Document
  File
}

enum ImageSize {
  THUMB
  MEDIUM
  LARGE
  ORIGINAL
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum Role {
  ADMIN
  CLIENT
  VENDOR
}

enum TokenType {
  REFRESH
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VendorUserRole {
  OWNER
  MANAGER
  STAFF
  VIEWER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CARD
  PAYPAL
  BANK_TRANSFER
  CASH_ON_DELIVERY
}

model Media {
  id                         String                      @id() @default(uuid())
  bucketKey                  String                      @unique()
  mediaType                  MediaType
  fileName                   String
  mimeType                   String
  fileSize                   Int
  isStale                    Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt()
  image                      Image?
  video                      Video?
  audio                      Audio?
  document                   Document?
  file                       File?
  productVariantGalleryMedia ProductVariantGalleryMedia?
  productVariantAttachment   ProductVariantAttachment?
}

model Image {
  id        String    @id()
  width     Int
  height    Int
  imageSize ImageSize
  parentId  String?
  parent    Image?    @relation("ImageParent", fields: [parentId], references: [id])
  children  Image[]   @relation("ImageParent")
  media     Media     @relation(fields: [id], references: [id])
}

model Video {
  id       String @id()
  duration Int
  media    Media  @relation(fields: [id], references: [id])
}

model Audio {
  id       String @id()
  duration Int
  media    Media  @relation(fields: [id], references: [id])
}

model Document {
  id    String @id()
  media Media  @relation(fields: [id], references: [id])
}

model File {
  id    String @id()
  media Media  @relation(fields: [id], references: [id])
}

model Product {
  id              String           @id() @default(uuid())
  slug            String           @unique()
  name            String
  description     String?
  status          ProductStatus    @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt()
  deletedAt       DateTime?
  tags            Tag[]            @relation("ProductTags")
  categories      Category[]       @relation("ProductCategories")
  productVariants ProductVariant[]
  ratings         Rating[]
  vendorId        String
  vendor          Vendor           @relation(fields: [vendorId], references: [id])
}

model ProductVariant {
  id           String                       @id() @default(uuid())
  productId    String
  featured     Boolean                      @default(false)
  sku          String?                      @unique()
  slug         String                       @unique()
  name         String
  description  String?
  color        String?
  weight       Json?
  dimensions   Json?
  price        Float
  stock        Int
  salePrice    Float?
  saleStart    DateTime?
  saleEnd      DateTime?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt()
  deletedAt    DateTime?
  product      Product                      @relation(fields: [productId], references: [id])
  orderItems   OrderItem[]
  cartItems    CartItem[]
  galleryMedia ProductVariantGalleryMedia[]
  attachments  ProductVariantAttachment[]

  @@index([slug])
  @@index([sku])
  @@index([productId])
}

model ProductVariantGalleryMedia {
  id               String         @id() @default(uuid())
  isPrimary        Boolean        @default(false)
  sortOrder        Int            @default(0)
  productVariantId String
  mediaId          String         @unique()
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  media            Media          @relation(fields: [mediaId], references: [id])
}

model ProductVariantAttachment {
  id               String         @id() @default(uuid())
  productVariantId String
  mediaId          String         @unique()
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  media            Media          @relation(fields: [mediaId], references: [id])
}

model Order {
  id                String      @id() @default(uuid())
  customerId        String
  total             Float
  status            OrderStatus
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt()
  customer          Customer    @relation(fields: [customerId], references: [id])
  orderItems        OrderItem[]
  payment           Payment?
  shippingAddressId String?
  shippingAddress   Address?    @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
}

model OrderItem {
  id             String         @id() @default(uuid())
  orderId        String
  productId      String
  quantity       Int
  price          Float
  order          Order          @relation(fields: [orderId], references: [id])
  productVariant ProductVariant @relation(fields: [productId], references: [id])
}

model Customer {
  id          String    @id() @default(uuid())
  name        String
  email       String
  phoneNumber String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  addresses   Address[]
  orders      Order[]
  userId      String?   @unique()
  cartId      String?   @unique()
  user        User?     @relation(fields: [userId], references: [id])
  cart        Cart?     @relation(fields: [cartId], references: [id])
}

model Address {
  id         String   @id() @default(uuid())
  customerId String
  street     String
  city       String
  state      String
  postalCode String
  country    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt()
  customer   Customer @relation(fields: [customerId], references: [id])
  orders     Order[]  @relation("ShippingAddress")
}

model Cart {
  id        String     @id() @default(uuid())
  cartItems CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt()
  deletedAt DateTime?
  customer  Customer?
}

model CartItem {
  id               String         @id() @default(uuid())
  cartId           String
  productVariantId String
  quantity         Int
  cart             Cart           @relation(fields: [cartId], references: [id])
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([cartId])
}

model User {
  id                String       @id() @default(uuid())
  email             String       @unique()
  password          String
  role              Role         @default(CLIENT)
  refreshTokens     Token[]
  emailVerifiedAt   DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt()
  customer          Customer?
  ratings           Rating[]
  vendorMemberships VendorUser[] @relation("VendorUserMembership")
}

model Token {
  id        String    @id() @default(uuid())
  token     String    @unique()
  type      TokenType
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  sessionId String?
  session   Session?  @relation(fields: [sessionId], references: [id])
}

model Session {
  id     String  @id() @default(uuid())
  tokens Token[]
}

model Rating {
  id        String   @id() @default(uuid())
  productId String
  userId    String
  rating    Int
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
}

model Vendor {
  id          String       @id() @default(uuid())
  name        String
  slug        String       @unique()
  description String?
  users       VendorUser[]
  products    Product[]
  status      VendorStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt()
}

model VendorUser {
  id        String         @id() @default(uuid())
  vendor    Vendor         @relation(fields: [vendorId], references: [id])
  vendorId  String
  user      User           @relation("VendorUserMembership", fields: [userId], references: [id])
  userId    String
  role      VendorUserRole @default(MANAGER)
  createdAt DateTime       @default(now())

  @@unique([vendorId, userId])
}

model Payment {
  id        String        @id() @default(uuid())
  orderId   String        @unique()
  amount    Float
  method    PaymentMethod
  status    PaymentStatus
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt()
  order     Order         @relation(fields: [orderId], references: [id])
}

model Category {
  id        String     @id() @default(uuid())
  name      String     @unique()
  slug      String     @unique()
  parentId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt()
  products  Product[]  @relation("ProductCategories")
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")
}

model Tag {
  id        String    @id() @default(uuid())
  name      String    @unique()
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt()
  products  Product[] @relation("ProductTags")
}

model Log {
  id          Int      @id() @default(autoincrement())
  level       String
  requestData Json?
  timestamp   DateTime @default(now())
  message     String
}
