import "./order.zmodel"

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CARD
  PAYPAL
  BANK_TRANSFER
  CASH_ON_DELIVERY
}
model Payment {
  id        String   @id @default(uuid())
  orderId   String   @unique
  amount    Float
  method    PaymentMethod
  status    PaymentStatus
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id])

  @@allow('all', true)
}
