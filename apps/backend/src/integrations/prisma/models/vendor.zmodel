import "./user.zmodel"
import "./product.zmodel"

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VendorUserRole {
  OWNER
  MANAGER
  STAFF
  VIEWER
}

model Vendor {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  owner       User       @relation("VendorOwner", fields: [ownerId], references: [id])
  ownerId     String

  // workspace members: users who can manage this vendor
  users       VendorUser[]

  // products listed under this vendor
  products    Product[]

  status      VendorStatus @default(PENDING)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@allow('all', true)
}

model VendorUser {
  id        String  @id @default(uuid())
  vendor    Vendor  @relation(fields: [vendorId], references: [id])
  vendorId  String
  user      User    @relation("VendorUserMembership", fields: [userId], references: [id])
  userId    String
  role      VendorUserRole @default(MANAGER)

  createdAt DateTime @default(now())

  @@unique([vendorId, userId])
  @@allow('all', true)
}
