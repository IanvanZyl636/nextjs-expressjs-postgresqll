import "./customer.zmodel"
import "./rating.zmodel"
import "./vendor.zmodel"
import "./cart.zmodel"

enum Role {
  ADMIN
  CLIENT
  VENDOR
}

enum TokenType {
  REFRESH
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  role           Role     @default(CLIENT)
  refreshTokens  Token[]
  emailVerifiedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer       Customer?
  ratings        Rating[]  

  // vendorMemberships VendorUser[] @relation("VendorUserMembership")

  @@allow('all', true)
}

model Token {
  id         String    @id @default(uuid())
  token      String    @unique
  type       TokenType
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id])

  @@allow('all', true)
}

model Session {
  id        String   @id @default(uuid())  

  tokens    Token[]

  @@allow('all', true)
}