import "./customer.zmodel"
import "./rating.zmodel"

enum Role {
  ADMIN
  CLIENT
}

enum TokenType {
  REFRESH
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  role           Role     @default(CLIENT)
  refreshTokens  Token[]
  emailVerifiedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer       Customer?
  ratings        Rating[]

  @@allow('all', true)
}

model Token {
  id         String    @id @default(uuid())
  token      String    @unique
  type       TokenType
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime   @default(now())
  ip         String?
  userAgent  String?

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])

  @@allow('all', true)
}

model Session {
  id        String   @id @default(uuid())  

  tokens    Token[]

  @@allow('all', true)
}