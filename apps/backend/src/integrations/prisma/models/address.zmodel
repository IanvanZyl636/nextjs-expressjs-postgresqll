import "./customer.zmodel"
import "./order.zmodel"
import "./shipping.zmodel"

model Address {
  id          String   @id @default(uuid())  
  street      String
  city        String
  state       String
  postalCode  String
  country     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt    

  shippingAddress ShippingAddress?

  @@allow('all', true)
}
