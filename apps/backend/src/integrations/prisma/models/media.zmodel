import "./product.zmodel"

enum MediaType {
  Image
  Video
  Audio
  Document
  File
}

enum ImageSize {
  THUMB
  MEDIUM
  LARGE
  ORIGINAL
}

model Media {
  id        String        @id @default(uuid())
  bucketKey String        @unique
  mediaType MediaType
  fileName  String
  mimeType  String
  fileSize  Int
  isStale   Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  product   ProductVariantMedia?

  @@allow("all", true)
  @@delegate(mediaType)
}

model Image extends Media {
  width     Int
  height    Int
  imageSize ImageSize
  
  parentId  String? 
  parent    Image?        @relation("ImageParent", fields: [parentId], references: [id])
  children  Image[]       @relation("ImageParent")
}

model Video extends Media {
  duration Int
}

model Audio extends Media {
  duration Int
}

model Document extends Media {
}

model File extends Media {
}