{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node", "express", "jest"],
    "rootDir": "src",    
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
  },
  "references": [
    { "path": "../../libs/shared" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ]
}