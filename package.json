{
  "name": "@nextjs-expressjs-postgresql/root",
  "scripts": {
    "backend:dev": "dotenv -e .env -- npm run dev --workspace=@nextjs-expressjs-postgresql/backend",
    "backend:build": "tsc -b",
    "backend:build:minify": "npm run build:minify --workspace=@nextjs-expressjs-postgresql/backend",
    "backend:start": "dotenv -e .env -- node ./apps/backend/dist/index.js",
    "backend:test": "dotenv -e .env -- npm run test --workspace=@nextjs-expressjs-postgresql/backend",
    "frontend:dev": "npm run dev --workspace=@nextjs-expressjs-postgresql/frontend",
    "frontend:build": "npm run build --workspace=@nextjs-expressjs-postgresql/frontend",
    "frontend:start": "npm run start --workspace=@nextjs-expressjs-postgresql/frontend",
    "docker:start": "docker compose up -d --no-deps --build",
    "docker:postgresql:start": "docker compose --profile postgresql up -d --no-deps --build",
    "docker:minio:start": "docker compose --profile minio up -d --no-deps --build",
    "docker:cloudflare:start": "docker compose --profile cloudflare up -d --no-deps --build",
    "zenstack:migrate":"npx zenstack generate --schema=apps/backend/src/integrations/prisma/schema.zmodel --output=../../../../../../libs/shared/src/prisma/generated",
    "prisma:migrate": "npx prisma migrate dev --schema=apps/backend/src/integrations/prisma/prisma",
    "prisma:reset": "npx prisma migrate reset --schema=apps/backend/src/integrations/prisma/prisma",
    "prisma:reset:force": "npx prisma migrate reset --force --schema=apps/backend/src/integrations/prisma/prisma",
    "prisma:reset:test": "dotenv -e .env.test -- npx prisma migrate reset --schema=apps/backend/src/integrations/prisma/prisma",
    "prisma:reset:force:test": "dotenv -e .env.test -- npx prisma migrate reset --force --schema=apps/backend/src/integrations/prisma/prisma",
    "prisma:deploy": "npx prisma migrate deploy --schema=apps/backend/src/integrations/prisma/prisma",
    "prisma:seed": "npx prisma db seed --schema=apps/backend/src/integrations/prisma/prisma"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^6.4.17",
    "dotenv-cli": "^9.0.0",
    "esbuild": "^0.25.8",
    "esbuild-plugin-alias": "^0.2.1",
    "esbuild-plugin-tsc": "^0.5.0",
    "esbuild-ts-paths": "^1.1.3",
    "jest": "^30.0.5",
    "nodemon": "^3.1.10",
    "prisma": "^6.12.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "zenstack": "2.18.0"
  },
  "dependencies": {
    "zod": "^4.0.10"
  }
}
